#include <Wire.h>

// LED
const int ledPin = 15; // LED connected to GPIO 15 (D15)

// Motor A
int motor1Pin1 = 27;
int motor1Pin2 = 26;
int enable1Pin = 14;

// Motor B
int motor2Pin1 = 25;
int motor2Pin2 = 33;
int enable2Pin = 32;

// PWM properties
const int freq = 30000;
const int pwmChannel1 = 0;
const int pwmChannel2 = 1;
const int resolution = 8;
int dutyCycle = 230;

// IR sensor ports
const int irSensorFrontL = 35;
const int irSensorFrontR = 34; // Analog input pin for the TCRT5000 sensor (right sensor)
const int threshold = 1000;    // Set a threshold for detecting the white tape (adjust based on testing)

// Ultrasonic sensor pins
#define TRIG_PIN_LEFT 23
#define ECHO_PIN_LEFT 19
#define TRIG_PIN_CENTER 18
#define ECHO_PIN_CENTER 5
#define TRIG_PIN_RIGHT 4
#define ECHO_PIN_RIGHT 2

// Variables to store the current sensor readings
int sensorValueFrontL = 0;
int sensorValueFrontR = 0;
long duration;
int distance;

// Function to get distance from an HC-SR04 sensor
int getDistance(int trigPin, int echoPin) {
    digitalWrite(trigPin, LOW);
    delayMicroseconds(2);

    digitalWrite(trigPin, HIGH);
    delayMicroseconds(10);
    digitalWrite(trigPin, LOW);

    duration = pulseIn(echoPin, HIGH);
    distance = duration * 0.034 / 2;
    return distance;
}

// Setup
void setup() {
    Serial.begin(115200);

    // LED Setup
    pinMode(ledPin, OUTPUT);
    digitalWrite(ledPin, LOW);

    // LED Sequence: Blink 5 times, then stay ON
    for (int i = 0; i < 4; i++) {
        digitalWrite(ledPin, HIGH); // Turn LED on
        delay(500);
        digitalWrite(ledPin, LOW); // Turn LED off
        delay(500);
    }
    digitalWrite(ledPin, HIGH); // Keep LED ON after blinking

    // Motor pin setup
    pinMode(motor1Pin1, OUTPUT);
    pinMode(motor1Pin2, OUTPUT);
    pinMode(enable1Pin, OUTPUT);
    pinMode(motor2Pin1, OUTPUT);
    pinMode(motor2Pin2, OUTPUT);
    pinMode(enable2Pin, OUTPUT);

    // IR sensor pin setup
    pinMode(irSensorFrontL, INPUT);
    pinMode(irSensorFrontR, INPUT);

    // Ultrasonic sensor setup
    pinMode(TRIG_PIN_LEFT, OUTPUT);
    pinMode(ECHO_PIN_LEFT, INPUT);
    pinMode(TRIG_PIN_CENTER, OUTPUT);
    pinMode(ECHO_PIN_CENTER, INPUT);
    pinMode(TRIG_PIN_RIGHT, OUTPUT);
    pinMode(ECHO_PIN_RIGHT, INPUT);

    // Configure LEDC PWM
    ledcSetup(pwmChannel1, freq, resolution);
    ledcAttachPin(enable1Pin, pwmChannel1);
    ledcSetup(pwmChannel2, freq, resolution);
    ledcAttachPin(enable2Pin, pwmChannel2);
}

// Function to move forward
void moveForward() {
    ledcWrite(pwmChannel1, dutyCycle);
    ledcWrite(pwmChannel2, dutyCycle);
    digitalWrite(motor1Pin1, LOW);
    digitalWrite(motor1Pin2, HIGH);
    digitalWrite(motor2Pin1, LOW);
    digitalWrite(motor2Pin2, HIGH);
}

// Function to stop motors
void stopMotors() {
    digitalWrite(motor1Pin1, LOW);
    digitalWrite(motor1Pin2, LOW);
    digitalWrite(motor2Pin1, LOW);
    digitalWrite(motor2Pin2, LOW);
}

// Loop
void loop() {
    // Read IR sensor values
    sensorValueFrontL = analogRead(irSensorFrontL);
    sensorValueFrontR = analogRead(irSensorFrontR);

    // Check for object detection within 30 cm using ultrasonic sensors
    bool isObjectLeft = getDistance(TRIG_PIN_LEFT, ECHO_PIN_LEFT) <= 30;
    bool isObjectCenter = getDistance(TRIG_PIN_CENTER, ECHO_PIN_CENTER) <= 30;
    bool isObjectRight = getDistance(TRIG_PIN_RIGHT, ECHO_PIN_RIGHT) <= 30;

    if (sensorValueFrontL >= threshold && sensorValueFrontR >= threshold) {
        // No boundary detected, move forward
        if (isObjectCenter) {
            Serial.println("Object Detected in Center: Moving Forward to Pursue");
            moveForward();
        } else {
            Serial.println("No Object Detected: Moving Forward");
            moveForward();
        }
    } else {
        // Boundary detected, check alignment
        if (sensorValueFrontL < threshold && sensorValueFrontR >= threshold) {
            Serial.println("Boundary Detected on Left: Adjusting Right");
            // Adjust right
        } else if (sensorValueFrontR < threshold && sensorValueFrontL >= threshold) {
            Serial.println("Boundary Detected on Right: Adjusting Left");
            // Adjust left
        } else {
            Serial.println("Boundary Detected: Stopping");
            stopMotors();
        }
    }

    delay(50);
}
